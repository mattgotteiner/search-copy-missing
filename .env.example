# Example .env file for copy-missing tool
# Copy this to .env and fill in your values

# Required: Azure Search endpoints
AZURE_SEARCH_SOURCE_ENDPOINT=https://your-source-service.search.windows.net
AZURE_SEARCH_DEST_ENDPOINT=https://your-dest-service.search.windows.net

# Optional: Admin keys (uses DefaultAzureCredential if not set)
# AZURE_SEARCH_SOURCE_KEY=your-source-admin-key
# AZURE_SEARCH_DEST_KEY=your-dest-admin-key

# Required: Field containing document timestamps (for partition scanning)
TIMESTAMP_FIELD=lastModifiedDateTime

# Optional: Key field (auto-detected from index definition if not set)
# KEY_FIELD=id

# Optional: Default index name (can override with --index)
# INDEX_NAME=my-index

# Optional: Number of partitions for parallel scanning (default: 8)
DESIRED_PARTITIONS=8

# Optional: Directory for state files (default: state)
STATE_DIR=state
